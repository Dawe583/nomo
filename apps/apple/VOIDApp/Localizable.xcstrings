{
  "sourceLanguage": "en",
  "strings": {
    "void.access.readOnly": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro čtení"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only"
          }
        }
      }
    },
    "void.access.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access"
          }
        }
      }
    },
    "void.action.offline": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline není dostupná žádná akce"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No action is available while offline"
          }
        }
      }
    },
    "void.action.readOnly": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze je jen pro čtení"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No action is available in this read-only build"
          }
        }
      }
    },
    "void.activity.durable": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená aktivita"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable activity"
          }
        }
      }
    },
    "void.activity.noCached.detail": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení trvalé aktivity připojte výslovně spárovaný executor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an explicitly paired executor to view durable activity."
          }
        }
      }
    },
    "void.activity.noCached.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné uložené relace"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cached sessions"
          }
        }
      }
    },
    "void.activity.stateNote": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválení, Zpět, konflikty, neznámé výsledky a pozastavené běhy se řeší na Macu. Tato aplikace zůstává jen pro čtení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval, Undo, conflicts, unknown outcomes, and paused runs are resolved on the Mac. This companion stays read-only."
          }
        }
      }
    },
    "void.activity.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivita"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity"
          }
        }
      }
    },
    "void.activity.workspace": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracovní prostor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace"
          }
        }
      }
    },
    "void.cache.detail": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co spárovaný executor odpoví, se na tomto zařízení neukládá trvale. Historie konverzace zůstává jen v paměti, je označena jako minulá aktivita a nikdy se nepoužije k rozhodnutí o dalším kroku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing a paired executor answers is kept on this device. Conversation history stays in memory, is labelled as past activity, and is never used to decide what happens next."
          }
        }
      }
    },
    "void.cache.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezipaměť"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache"
          }
        }
      }
    },
    "void.cancel": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "void.chat.composer.idle": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání vyžaduje spárovaný Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending requires a paired Mac."
          }
        }
      }
    },
    "void.chat.composer.placeholder": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište zprávu…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a message…"
          }
        }
      }
    },
    "void.chat.composer.status.executorOffline": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psát nelze: spárovaný Mac není dostupný."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composing is unavailable: the paired Mac is not reachable."
          }
        }
      }
    },
    "void.chat.composer.status.noExecutorSelected": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psát nelze: není vybraný spárovaný executor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composing is unavailable: no paired executor is selected."
          }
        }
      }
    },
    "void.chat.composer.status.readOnlyBuild": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psát ani odesílat nelze: tato verze nemá přenosovou cestu k Macu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composing and sending are unavailable: this build has no transport to the Mac."
          }
        }
      }
    },
    "void.chat.empty.detail": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Executor znal tuto konverzaci a neposlal pro ni žádné události. Není to totéž co nevidět historii."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The executor knew this conversation and sent no events for it. That is not the same as being unable to see its history."
          }
        }
      }
    },
    "void.chat.empty.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné zprávy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages yet"
          }
        }
      }
    },
    "void.chat.loading": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
