    },
    "void.revoke.message": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další požadavky budou odepřeny, dokud zařízení znovu nespárujete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
