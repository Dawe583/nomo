    "void.remove.device": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat toto zařízení"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this device"
          }
        }
      }
    },
    "void.remove.device.done": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení bylo odebráno a jeho přihlašovací údaje smazány."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was removed and its credential deleted."
          }
        }
      }
    },
    "void.remove.device.message": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlašovací údaje zařízení se smažou z klíčenky a všechno, co tato aplikace uložila, se vyprázdní. Executor musí zařízení znovu spárovat, než bude možné pokračovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's credential is deleted from the Keychain and everything this app cached is cleared. The executor must pair the device again before anything else works."
          }
        }
      }
    },
    "void.remove.device.title": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat párování tohoto zařízení?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this device pairing?"
          }
        }
      }
    },
    "void.remove.device.unconfirmed": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení bylo odebráno lokálně. Executor nebyl dosažen, takže párování zrušte na Macu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was removed on this side. The executor was not reachable, so revoke the pairing on the Mac too."
          }
        }
      }
    },
    "void.revoke": {
      "localizations": {
