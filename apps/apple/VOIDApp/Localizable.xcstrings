            "state": "translated",
            "value": "Revoke this device pairing?"
          }
        }
      }
    },
    "void.settings.pairing.policy": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Párování vyžaduje výslovně vybraný vlastní Mac. VOID nevyhledává ani nedůvěřuje libovolným serverům."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing requires an explicitly selected, user-owned executor. VOID does not discover or trust arbitrary servers."
          }
        }
      }
    },
    "void.settings.privacy.detail": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do protokolů ani UserDefaults se nezapisují přihlašovací údaje, výzvy, obsah dokumentů ani tajné údaje párování."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
