        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se jen okno událostí. Executor musí oznámit, zda je tato stránka úplná."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an event window is shown. The executor has to report whether this page is complete."
