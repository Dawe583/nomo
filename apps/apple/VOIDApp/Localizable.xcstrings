    "void.chat.stopped.detail.noToolWork": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, který dorazil, zůstal zčástný. Žádný nástroj nebyl přijat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text that had arrived stays partial. No tool was accepted."
          }
        }
      }
    },
    "void.chat.stopped.detail.pendingToolWork": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, který dorazil, zůstává. Již odeslaný požadavek na nástroj pokračuje na Macu; zastavení ho neodvolá."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text that had arrived is kept. The tool request already submitted keeps running on the Mac; stopping does not recall it."
          }
        }
      }
    },
