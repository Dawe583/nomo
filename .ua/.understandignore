# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- Active exclusions for NOMO (2026-11-24) ---
# Generated CLI bundles: the composer build directory keeps a full previous
# dist, which is 75k lines of bundled output and swamps every analysis batch.
packages/cli/.nomo-composer-build.*/
# Local agent tooling captures and per-harness config, not product source.
.nomo/
.playwright-mcp/
.gstack/
.devin/
.kiro/
.omp/
.opencode/
.agents/
.worktrees/
test_env

