# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# The pnpm store .gitlab-ci.yml redirects into the checkout. Tool state, not
# repository content: without this the licence-line gate classifies a
# directory the build left behind.
.pnpm-store/

# The work graph is loop state for one checkout, not repository content. It is
# ignored rather than classified, so a lane that holds a graph and a clean gate
# checkout that does not both describe the same tree.
.nomo/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Scratch output from the api function emit check
.tsc-api-emit

# graphify knowledge graph output: regenerable, contains the forbidden dash
# characters in generated prose, and never ships
graphify-out/

# A violating emit under api/ writes .js next to its TypeScript source here.
# api/tsconfig.json deliberately does not set noEmitOnError, so keep the stray
# output out of git rather than committing it. Scoped to src/ on purpose: a
# blanket packages/**/*.js would also swallow a committed bin entry point, and
# git would refuse it without -f while git status stayed silent about why.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
.vercel
.env*
/.swc

/.nitro

# Local operator exports may contain private conversation and ledger data
/nomo-exports/
# Local harness MCP configuration can contain credentials and machine paths.
/.omp/mcp.json
/.pi/mcp.json
# OpenCOOP project history (snapshots, members)
.opencoop/
# Local browser/terminal diagnostics
.playwright-mcp/
test-results/

# Nested git worktrees. Most lanes live beside the checkout in ../nomo-lanes/,
# but a lane created inside it lands here, and a worktree is a full checkout:
# without this it shows as an untracked directory in every git status and one
# `git add -A` away from committing a second copy of the tree.
.worktrees/
# Swift Package Manager and Python test artifacts
.build/
__pycache__/

# Local advisor harness config. Personal tooling, not product code.
WATCHDOG.yml
