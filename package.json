{
  "name": "@nomo/workspace",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "test:tui": "node --test --test-concurrency=1 packages/cli/src/tui/*.test.ts && python3 scripts/src/verify-tui-terminal.py",
    "preinstall": "node scripts/src/preinstall.mjs",
    "nomo": "node packages/cli/bin/nomo.mjs",
    "tui": "node packages/cli/bin/nomo.mjs tui",
    "tui:preview": "pnpm --filter @nomo/cli run tui:preview --",
    "typecheck": "pnpm -r --workspace-concurrency=1 --filter \"./packages/**\" --filter \"./scripts\" --if-present run typecheck && tsc -p apps/control-plane/tsconfig.json && tsc -p paid/tsconfig.json && pnpm --filter @void/control-plane-ui typecheck",
    "test": "node scripts/src/check-tests.mjs",
    "check": "pnpm run typecheck && pnpm test",
    "check:mirror": "node scripts/src/check-registry-mirror.mjs",
    "gui": "pnpm build:web && node apps/control-plane/api/server.ts",
    "watch": "node packages/cli/bin/nomo.mjs watch",
    "desktop:setup": "pnpm --dir apps/desktop install --ignore-workspace",
    "desktop": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:test": "pnpm --dir apps/desktop test",
    "apple:project": "sh -c 'cd apps/apple && xcodegen generate'",
    "apple:project:check": "node scripts/src/check-apple-project.mjs",
    "apple:design:test": "swift test -j 1 --package-path apps/apple/NomoDesignSystem",
    "build:web": "node scripts/src/build-web.mjs",
    "dev:web": "pnpm --filter @void/control-plane-ui dev",
    "test:reverse": "node scripts/src/check-reverse-engine.mjs",
    "build": "node scripts/src/build-web.mjs && nitro build && node scripts/src/check-cloud-build.mjs"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "description": "NOMO development workspace for accountable AI tool calls, signed ledgers, and guarded replay.",
  "bin": {
    "nomo": "packages/cli/bin/nomo.mjs",
    "nomo-proxy": "packages/proxy/bin/nomo-proxy.mjs"
  },
  "keywords": [
    "nomo",
    "mcp",
    "ai-safety",
    "audit",
    "reversibility"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@polar-sh/sdk": "1.0.1",
    "@vercel/oidc": "^3.8.7",
    "express": "^5.2.1",
    "nitro": "3.0.260903-beta",
    "pg": "8.16.3",
    "rollup": "^4.63.1",
    "workflow": "^4.8.9"
  }
}
